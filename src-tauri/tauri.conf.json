{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZGT",
  "version": "0.1.2",
  "identifier": "com.zeoz.zgt.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "shortDescription": "ZEOZ Gestión Taller",
    "longDescription": "Aplicación de escritorio de ZEOZ Gestión Taller para Windows y macOS.",
    "publisher": "ZEOZ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
